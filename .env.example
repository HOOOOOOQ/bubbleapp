# BubbleApp configuration template. Copy to .env (ignored by git) and fill in values from your
# Supabase project. Never put SUPABASE_SERVICE_ROLE_KEY or FCM private keys in the Flutter app.

# --- Flutter client (passed with --dart-define; the anon/publishable key is public by design) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# --- Edge Functions (set with: supabase secrets set --env-file .env.functions) ---
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically
# into functions. Do not set them as secrets (names starting with SUPABASE_ are reserved).
# Shared secret for the scheduler that calls scheduled-jobs (x-job-secret header).
JOB_SECRET=generate-with-openssl-rand-hex-32
# Shared secret for the Database Webhook that calls push-dispatch (x-webhook-secret header).
PUSH_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32
# Firebase Cloud Messaging (HTTP v1). Service account JSON from the Firebase console.
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n"

# --- Operator tooling only (never shipped to clients) ---
# Connection string for scripts/test_db.sh. Must point at a DISPOSABLE database.
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres
# Supabase CLI login and project, used by `supabase link` / `supabase db push`.
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_ACCESS_TOKEN=created-in-supabase-dashboard-account-settings
